# Deepgram API key - get one at https://deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Google Gemini API key - get one at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Google Drive API key for browsing/importing public shared folders
GOOGLE_DRIVE_API_KEY=your_google_drive_api_key_here

# Optional: secret key to protect the app with a single shared password instead
# of per-user Supabase accounts. Mutually exclusive with the Supabase auth vars
# below — if both are set, Supabase wins. If neither is set, the app is open
# for local development.
# Example generator: openssl rand -hex 32
APP_SECRET_KEY=your_secret_key_here

# Supabase Auth (multi-user accounts + per-user library). Leave both unset to
# use APP_SECRET_KEY instead. NEXT_PUBLIC_SUPABASE_URL must be reachable from
# the browser (e.g. http://localhost:8000 from SUPABASE_PUBLIC_URL below).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only override: lets the `crammer` container reach Kong over the
# docker network (http://api-gw:8000) instead of going back out through the
# host's published port. Leave unset for `npm run dev` outside docker.
SUPABASE_URL=


############################################################
# Self-hosted Supabase (docker-compose: db/auth/rest/storage/realtime/studio/kong)
#
# The values below are the well-known public Supabase demo secrets.
# They work out of the box for `docker compose up` on localhost, but
# MUST be regenerated before this stack is reachable from anywhere else.
# Run: sh supabase/generate-secrets.sh
############################################################

# Postgres
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password

# Legacy symmetric HS256 key + matching API keys (regenerate together, see script above)
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJzZXJ2aWNlX3JvbGUiLAogICAgImlzcyI6ICJzdXBhYmFzZS1kZW1vIiwKICAgICJpYXQiOiAxNjQxNzY5MjAwLAogICAgImV4cCI6IDE3OTk1MzU2MDAKfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q

# Optional newer opaque API key pair / asymmetric JWKS - leave blank to use the legacy keys above
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

# Dashboard (Studio) basic auth, exposed at SUPABASE_PUBLIC_URL behind Kong
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=this_password_is_insecure_and_should_be_updated

SECRET_KEY_BASE=UpNVntn3cDxHJpq99YMc1T1AQgQpc8kfYTuRgBiYa15BLrx8etQoXz3gZv1/u2oq
VAULT_ENC_KEY=your-32-character-encryption-key
PG_META_CRYPTO_KEY=your-encryption-key-32-chars-min

# Local file-backed storage buckets (no S3 needed) - GLOBAL_S3_BUCKET is the on-disk folder name
GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub
S3_PROTOCOL_ACCESS_KEY_ID=625729a08b95bf1b7ff351a663f3a23c
S3_PROTOCOL_ACCESS_KEY_SECRET=850181e4652dd023b7a98c58ae0d2d34bd487ee0cc3254aed6eda37307425907

# URLs - update these to your real domain for any non-localhost deployment
SUPABASE_PUBLIC_URL=http://localhost:8000
API_EXTERNAL_URL=http://localhost:8000
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=

# Kong (API gateway) ports
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# Auth behavior
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# SMTP - required for real signup/password-reset emails; defaults below only satisfy GoTrue's startup checks
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=crammer

# PostgREST schema exposure
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

# Edge Functions
FUNCTIONS_VERIFY_JWT=false

# Studio
STUDIO_DEFAULT_ORGANIZATION=Crammer
STUDIO_DEFAULT_PROJECT=Crammer
OPENAI_API_KEY=

# Supavisor (connection pooler) - POSTGRES_PORT above is proxied through this
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=your-tenant-id
POOLER_DB_POOL_SIZE=5

# imgproxy
IMGPROXY_AUTO_WEBP=true
